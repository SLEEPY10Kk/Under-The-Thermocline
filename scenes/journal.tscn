[node name="Main" type="Node2D" unique_id=1744141244]
script = ExtResource("1_mf1i3")
pages = Array[String](["well, it has been going smoothly, although robert and kaiden are a bit erratic but nothing unusual , i mean ive seen robert complete a report while taking a shit so nothing to worry.", " the things they keep on saying is bogus, robert says he feels his mind feel clouded and convoluted like never before ", " i really just think he's off his meds again. but for kaiden though, he says he saw a bizzare reading on the navigator,", "kaiden isnt a resercher but i have no reason to doubt his judgement but oh well , random shit happens, we will continue researching this depth level and then continue our descent .", "Shawn and robert are still performing the routine proceedings with the marine life species , the amount of new species we have discovered", "is just astounishing but its expected because these are \"uncharted waters\" nobody has truly taken the time to explore this part of the trench", "because of \"no monetary benefits\" i didnt become a Deep-Sea Biogeochemist to listen to this BS like genuienly what the fuck happened", "to \"for the greater good of mankind\" . well what did i expect, this dive is expected to just slightly touch a hadal zone around 7000 meters , our sub", "is only equipped to go till 6500 meters after which we intend to survey with a ROV ofcourse but i dont think that will do jackshit in the hadal zone ,we'll see when we get there though"])
font_size = 6
text_box_size = Vector2(100, 120)
text_box_offset = Vector2(-52, -64)

